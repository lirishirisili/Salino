<?xml version="1.0" encoding="utf-8"?>
<!-- Appodeal: allow cleartext where networks require it (docs.appodeal.com/android/get-started). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
